    -- Sliding tab indicator (gradient accent line)
    local tabInd = Instance.new("Frame")
    tabInd.Size = UDim2.new(0,0,0,2); tabInd.Position = UDim2.new(0,0,1,-1)
    tabInd.BackgroundColor3 = C.accent; tabInd.BorderSizePixel = 0; tabInd.ZIndex = 12; tabInd.Parent = TH
    corner(tabInd, 1)
    local indGrad = Instance.new("UIGradient")
    indGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0,   C.accentD),
        ColorSequenceKeypoint.new(0.5, C.accent),
        ColorSequenceKeypoint.new(1,   C.accentL),
    }; indGrad.Parent = tabInd

    -- Absolute sizes are multiplied by the window scale, so divide it back out
    local function placeInd(tab, animated, tries)
        tries = tries or 0
        local s  = MainScale.Scale
        local ba, ta, bs = tab.hBtn.AbsolutePosition, TH.AbsolutePosition, tab.hBtn.AbsoluteSize
        if bs.X <= 0 or s < 0.05 then
            if tries < 6 then
                task.delay(0.05, function()
                    if W.ActiveTab == tab and not W.SidebarMode then placeInd(tab, animated, tries + 1) end
                end)
            end
            return
        end
        local pos, size = UDim2.new(0,(ba.X-ta.X)/s,1,-1), UDim2.new(0,bs.X/s,0,2)
        if animated then
            tabInd.BackgroundTransparency = 0
            anim(tabInd, {Position = pos, Size = size}, 0.4, QUINT)
        else
            tabInd.Position = pos; tabInd.Size = size
            anim(tabInd, {BackgroundTransparency = 0}, 0.25)
        end
    end

    -- ── Sidebar ──────────────────────────────
    local SB = Instance.new("Frame"); SB.Name = "Sidebar"
