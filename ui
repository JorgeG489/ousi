    -- Only one dropdown list open at a time; W._dd = {close, list, btn}
    function W:CloseDropdown()
        local d = self._dd
        if d then self._dd = nil; d.close() end
    end
    local function inside(g, p)
        local ap, as = g.AbsolutePosition, g.AbsoluteSize
        return p.X >= ap.X and p.X <= ap.X+as.X and p.Y >= ap.Y and p.Y <= ap.Y+as.Y
    end
    table.insert(W.Conns, UserInputService.InputBegan:Connect(function(i)
        local d = W._dd
        if d and isMoveInput(i) and not inside(d.list, i.Position) and not inside(d.btn, i.Position) then
            W:CloseDropdown()
        end
    end))

    -- ══════════════════════════════════════
    -- SWITCH MODE
    -- ══════════════════════════════════════
    local _sw = false
    function W:SwitchMode(toSB)
        if _sw or self.Locked or toSB == self.SidebarMode then return end
        self:CloseDropdown()
        _sw = true; self.SidebarMode = toSB; self.Minimized = false

        local D = 0.46
        anim(Fade, {BackgroundTransparency = 0.35}, D*0.3, SINE, INOUT)
        swLook(false)

        -- 1) current navigation leaves
        if toSB then
            anim(tabInd, {BackgroundTransparency = 1}, 0.15)
            for _, t in ipairs(self.Tabs) do
                anim(t.hBtn, {TextTransparency = 1, BackgroundTransparency = 1}, D*0.28, SINE)
            end
            anim(TH, {Position = UDim2.new(0,12,0,-60)}, D*0.36, SINE, IN)
        else
            anim(SB,    {Position = UDim2.new(0,-140,0,hH)}, D*0.4,  QUART, IN)
            anim(SBDiv, {BackgroundTransparency = 1},        D*0.36, SINE)
        end

        task.wait(D*0.36)
        if toSB then TH.Visible = false else SB.Visible = false end

        -- 2) window and page area morph to the new layout
        local target = toSB and pS or pH
        fullSz = toSB and sideSz or defSz
        anim(Main,     {Size = fullSz},                             D, QUINT, INOUT)
        anim(PageArea, {Position = target.pos, Size = target.sz},   D, QUINT, INOUT)

        task.wait(D*0.44)

        -- 3) new navigation arrives, tab names cascade in
        if toSB then
            SB.Position = UDim2.new(0,-140,0,hH); SB.Visible = true
            anim(SB,    {Position = UDim2.new(0,0,0,hH)}, D*0.75, QUINT)
            anim(SBDiv, {BackgroundTransparency = 0},     D*0.75, QUINT)
            for n, t in ipairs(self.Tabs) do
                t.vBtn.TextTransparency = 1; t.vBtn.BackgroundTransparency = 1
                t.vBtn.TextColor3 = (t == self.ActiveTab) and C.text or C.dim
                t.vInd.Size = UDim2.new(0,0,0.5,0); t.vInd.BackgroundTransparency = 1
                task.delay((n-1)*0.04, function() anim(t.vBtn, {TextTransparency = 0}, 0.32) end)
            end
        else
            TH.Position = UDim2.new(0,12,0,-60); TH.Visible = true
            for n, t in ipairs(self.Tabs) do
                t.hBtn.TextTransparency = 1; t.hBtn.BackgroundTransparency = 1
                t.hBtn.TextColor3 = (t == self.ActiveTab) and C.text or C.dim
                task.delay((n-1)*0.04, function() anim(t.hBtn, {TextTransparency = 0}, 0.32) end)
            end
            anim(TH, {Position = UDim2.new(0,12,0,tabYPos)}, D*0.65, QUINT)
        end

        anim(Fade, {BackgroundTransparency = 1}, D*0.55, SINE)
        task.wait(D*0.2)

        -- 4) active tab highlight
        local a = self.ActiveTab
        if a then
            if toSB then
                anim(a.vBtn, {BackgroundTransparency = 0.92}, 0.22, SINE)
                anim(a.vInd, {Size = UDim2.new(0,2,0.5,0), BackgroundTransparency = 0}, 0.3, QUINT)
            else
                anim(a.hBtn, {BackgroundTransparency = 0.92}, 0.22, SINE)
                tabInd.BackgroundTransparency = 1
                task.defer(function() placeInd(a, false) end)
            end
        end
        task.wait(0.08); _sw = false
    end

    -- ══════════════════════════════════════
    -- KEY SYSTEM  (small prompt -> morphs into the full window)
    -- ══════════════════════════════════════
    local KP
    local GREEN, RED = Color3.fromRGB(74,222,128), Color3.fromRGB(248,113,113)
    W._keyWaiters = {}

    -- Yields until the key has been accepted; returns the key
    function W:WaitForKey()
        if self.KeyValid then return self.Key end
        table.insert(self._keyWaiters, coroutine.running())
        coroutine.yield()
        return self.Key
    end

    if W.Locked then
        -- Hide everything that belongs to the full window
        TH.Visible = false; PageArea.Visible = false
        swBtn.Visible = false; minB.Visible = false

        -- CanvasGroup lets the whole prompt fade out in a single tween
        KP = Instance.new("CanvasGroup"); KP.Name = "KeyPanel"
        KP.Size = UDim2.new(1,0,1,-hH); KP.Position = UDim2.new(0,0,0,hH)
        KP.BackgroundTransparency = 1; KP.BorderSizePixel = 0; KP.ZIndex = 5; KP.Parent = Body

        local note = Instance.new("TextLabel"); note.Size = UDim2.new(1,-32,0,14); note.Position = UDim2.new(0,16,0,12)
        note.BackgroundTransparency = 1; note.Text = KS.Note or "Enter your key to continue"
        note.TextColor3 = C.sub; note.TextSize = S.txtSm; note.Font = Enum.Font.GothamMedium
        note.TextXAlignment = Enum.TextXAlignment.Left; note.ZIndex = 5; note.Parent = KP

        local field = Instance.new("Frame"); field.Size = UDim2.new(1,-32,0,kFieldH); field.Position = UDim2.new(0,16,0,kFieldY)
        field.BackgroundColor3 = C.card; field.BorderSizePixel = 0; field.ZIndex = 5; field.Parent = KP; corner(field, 7)
        local fStroke = stroke(field, C.stroke, 0.1)

        local box = Instance.new("TextBox"); box.Size = UDim2.new(1,-20,1,0); box.Position = UDim2.new(0,10,0,0)
        box.BackgroundTransparency = 1; box.Text = ""; box.PlaceholderText = "Paste your key here..."
        box.PlaceholderColor3 = C.dim; box.TextColor3 = C.text; box.TextSize = S.txt
        box.Font = Enum.Font.GothamMedium; box.TextXAlignment = Enum.TextXAlignment.Left
        box.ClearTextOnFocus = false; box.TextTruncate = Enum.TextTruncate.AtEnd; box.ZIndex = 6; box.Parent = field
        box.Focused:Connect(function() anim(fStroke, {Color = C.accent}, 0.2) end)
        box.FocusLost:Connect(function() anim(fStroke, {Color = C.stroke}, 0.25) end)

        local function mkBtn(text, xScale, xOff, accent)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0.5,-21,0,kBtnH); b.Position = UDim2.new(xScale,xOff,0,kBtnY)
            b.BackgroundColor3 = accent and C.accent or C.none; b.BorderSizePixel = 0; b.AutoButtonColor = false
            b.Text = text; b.TextColor3 = accent and Color3.new(1,1,1) or C.text; b.TextSize = S.txt
            b.Font = Enum.Font.GothamBold; b.ClipsDescendants = true; b.ZIndex = 5; b.Parent = KP; corner(b, 7)
            local base = b.BackgroundColor3
            b.MouseEnter:Connect(function() anim(b, {BackgroundColor3 = accent and C.accentL or C.noneHi}, 0.16) end)
            b.MouseLeave:Connect(function() anim(b, {BackgroundColor3 = base}, 0.22) end)
            return b
        end
        local getBtn = mkBtn("Get Key", 0, 16, false)
        local verBtn = mkBtn("Verify",  0.5, 5, true)

        local status = Instance.new("TextLabel"); status.Size = UDim2.new(1,-32,0,14); status.Position = UDim2.new(0,16,0,kStatY)
        status.BackgroundTransparency = 1; status.Text = ""; status.TextColor3 = C.sub
        status.TextSize = S.txtXs; status.Font = Enum.Font.GothamMedium; status.TextXAlignment = Enum.TextXAlignment.Left
        status.TextTruncate = Enum.TextTruncate.AtEnd; status.ZIndex = 5; status.Parent = KP

        local function say(msg, col)
            status.Text = msg; status.TextColor3 = col or C.sub
            status.TextTransparency = 1; anim(status, {TextTransparency = 0}, 0.25)
        end
        local function shake()
            local x = field.Position.X.Offset
            for _, dx in ipairs({-6, 6, -4, 4, 0}) do
                anim(field, {Position = UDim2.new(0, x + dx, 0, kFieldY)}, 0.05, SINE)
                task.wait(0.05)
            end
        end

        -- Restore a previously accepted key
        local keyFile = KS.SaveFile
        if keyFile and isfile and readfile then
            local ok, saved = pcall(function() return isfile(keyFile) and readfile(keyFile) or nil end)
            if ok and saved and saved ~= "" then box.Text = saved end
        end

        getBtn.MouseButton1Click:Connect(function()
            ripple(getBtn)
            if not KS.GetKey then return say("No key link configured", RED) end
            local ok, link, err = pcall(KS.GetKey)
            if ok and link then
                if setclipboard then setclipboard(link); say("Link copied to clipboard", GREEN)
                else say(tostring(link), C.text) end
            else
                say("Could not create link: " .. tostring(ok and err or link), RED)
            end
        end)

        local busy = false
        local function submit()
            if busy or W.KeyValid then return end
            local key = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
            if key == "" then say("Enter a key first", RED); task.spawn(shake); return end
            busy = true; verBtn.Text = "Checking..."; say("Validating key...", C.sub)
            ripple(verBtn)

            local ok, valid, msg = pcall(KS.Validate, key)
            busy = false; verBtn.Text = "Verify"
            if not ok or not valid then
                say(tostring(ok and msg or valid or "Invalid key"), RED)
                task.spawn(shake)
                return
            end

            if keyFile and writefile then pcall(writefile, keyFile, key) end
            W.Key = key; W.KeyValid = true
            say(msg or "Key accepted", GREEN)
            verBtn.Text = "Loading..."; anim(verBtn, {BackgroundColor3 = GREEN}, 0.3)
            box.TextEditable = false

            for _, th in ipairs(W._keyWaiters) do task.spawn(th) end
            W._keyWaiters = {}
            if KS.OnValidated then task.spawn(KS.OnValidated, key) end
            if KS.AutoUnlock then task.wait(0.35); W:Unlock() end
        end
        verBtn.MouseButton1Click:Connect(submit)
        box.FocusLost:Connect(function(enter) if enter then submit() end end)
    end

    -- Key accepted -> the prompt fades, the window grows into the full UI, tabs and pages cascade in
    function W:Unlock()
        if not self.Locked or self._unlocking then return end
        self._unlocking = true
        local D = 0.85

        anim(KP, {GroupTransparency = 1}, 0.22, SINE)
        task.wait(0.2)
        KP.Visible = false

        -- Prepare the full-window pieces while they are still invisible
        TH.Position = UDim2.new(0,12,0,-60); TH.Visible = true
        for _, t in ipairs(self.Tabs) do
            t.hBtn.TextTransparency = 1; t.hBtn.BackgroundTransparency = 1
        end
        Fade.BackgroundTransparency = 0; PageArea.Visible = true
        swBtn.Visible = true; minB.Visible = true

        -- Grow from the centre; Body clips and the page area follows its size
        fullSz = defSz
        anim(Main, {Size = defSz}, D, QUINT, INOUT)
        task.wait(D * 0.42)

        anim(TH, {Position = UDim2.new(0,12,0,tabYPos)}, D * 0.6, QUINT)
        for n, t in ipairs(self.Tabs) do
            task.delay((n-1) * 0.05, function() anim(t.hBtn, {TextTransparency = 0}, 0.34) end)
        end
        anim(Fade, {BackgroundTransparency = 1}, D * 0.65, SINE)
        task.wait(D * 0.58)

        local a = self.ActiveTab
        if a then
            anim(a.hBtn, {BackgroundTransparency = 0.92}, 0.22, SINE)
            tabInd.BackgroundTransparency = 1
            task.defer(function() placeInd(a, false) end)
        end
        self.Locked = false; self._unlocking = false
        pcall(function() KP:Destroy() end)
    end

    -- ══════════════════════════════════════
    -- ADD TAB
    -- ══════════════════════════════════════
    function W:AddTab(name)
        local Tab = {Name = name, Window = self}

        local Page = Instance.new("ScrollingFrame"); Page.Name = name; Page.Size = UDim2.new(1,0,1,0)
        Page.BackgroundTransparency = 1; Page.BorderSizePixel = 0; Page.ScrollBarThickness = 2
        Page.ScrollBarImageColor3 = C.dim; Page.CanvasSize = UDim2.new(0,0,0,0)
        hoverScroll(Page); Page.Visible = false; Page.ZIndex = 3; Page.Parent = Pages
        pad(Page, 2,2,2,2)
        -- An open dropdown list floats above the page, so it can't follow a scroll
        Page:GetPropertyChangedSignal("CanvasPosition"):Connect(function() W:CloseDropdown() end)

        local Cols = Instance.new("Frame"); Cols.Name = "Cols"; Cols.Size = UDim2.new(1,0,0,0)
        Cols.AutomaticSize = Enum.AutomaticSize.Y; Cols.BackgroundTransparency = 1; Cols.Parent = Page

        -- Single column on phones, two columns on tablets/desktop
        local singleCol = isMobile and getVP().X < 520
        local CL = Instance.new("UIListLayout")
        CL.FillDirection = singleCol and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
        CL.Padding = UDim.new(0,8); CL.SortOrder = Enum.SortOrder.LayoutOrder; CL.Parent = Cols

        local LCol = Instance.new("Frame"); LCol.Name = "L"
        LCol.Size = singleCol and UDim2.new(1,0,0,0) or UDim2.new(0.5,-4,1,0)
        if singleCol then LCol.AutomaticSize = Enum.AutomaticSize.Y end
        LCol.BackgroundTransparency = 1; LCol.LayoutOrder = 1; LCol.Parent = Cols
        local LCL = Instance.new("UIListLayout"); LCL.Padding = UDim.new(0,8); LCL.SortOrder = Enum.SortOrder.LayoutOrder; LCL.Parent = LCol

        local RCol = Instance.new("Frame"); RCol.Name = "R"
        RCol.Size = singleCol and UDim2.new(1,0,0,0) or UDim2.new(0.5,-4,1,0)
        if singleCol then RCol.AutomaticSize = Enum.AutomaticSize.Y end
        RCol.BackgroundTransparency = 1; RCol.LayoutOrder = 2; RCol.Parent = Cols
        local RCL = Instance.new("UIListLayout"); RCL.Padding = UDim.new(0,8); RCL.SortOrder = Enum.SortOrder.LayoutOrder; RCL.Parent = RCol

        local function updCanvas()
            if singleCol then
                Page.CanvasSize = UDim2.new(0,0,0, LCL.AbsoluteContentSize.Y + RCL.AbsoluteContentSize.Y + 16)
            else
                Page.CanvasSize = UDim2.new(0,0,0, math.max(LCL.AbsoluteContentSize.Y, RCL.AbsoluteContentSize.Y)+8)
            end
        end
        LCL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updCanvas)
        RCL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updCanvas)

        Tab.Page = Page; Tab.LCol = LCol; Tab.RCol = RCol; Tab.Cols = Cols

        -- H tab button
        local hBtn = Instance.new("TextButton"); hBtn.Size = UDim2.new(0,0,1,0); hBtn.AutomaticSize = Enum.AutomaticSize.X
        hBtn.BackgroundTransparency = 1; hBtn.BackgroundColor3 = C.accent; hBtn.AutoButtonColor = false
        hBtn.Text = name; hBtn.TextColor3 = C.dim; hBtn.TextSize = S.txt
        hBtn.Font = Enum.Font.GothamMedium; hBtn.LayoutOrder = #self.Tabs+1; hBtn.Parent = THContainer
        pad(hBtn, 0,0,9,9); corner(hBtn, 4)

        -- V tab button (sidebar)
        local vBtn = Instance.new("TextButton")
        vBtn.Size = UDim2.new(1,0,0,isMobile and 36 or 30); vBtn.BackgroundTransparency = 1
        vBtn.BackgroundColor3 = C.accent; vBtn.AutoButtonColor = false
        vBtn.Text = name; vBtn.TextColor3 = C.dim; vBtn.TextSize = S.txt; vBtn.Font = Enum.Font.GothamMedium
        vBtn.TextXAlignment = Enum.TextXAlignment.Left; vBtn.LayoutOrder = #self.Tabs+1; vBtn.Parent = SBScroll
        corner(vBtn, 5); pad(vBtn, 0,0,10,0)

        local vInd = Instance.new("Frame"); vInd.Size = UDim2.new(0,0,0.5,0); vInd.Position = UDim2.new(0,-2,0.25,0)
        vInd.BackgroundColor3 = C.accent; vInd.BackgroundTransparency = 1; vInd.BorderSizePixel = 0; vInd.Parent = vBtn; corner(vInd, 1)

        Tab.hBtn = hBtn; Tab.vBtn = vBtn; Tab.vInd = vInd

        hBtn.MouseButton1Click:Connect(function() W:SelectTab(Tab) end)
        vBtn.MouseButton1Click:Connect(function() W:SelectTab(Tab) end)

        hBtn.MouseEnter:Connect(function()
            if W.ActiveTab ~= Tab then anim(hBtn, {TextColor3=C.text,BackgroundTransparency=0.94}, 0.18) end
        end)
        hBtn.MouseLeave:Connect(function()
            if W.ActiveTab ~= Tab then anim(hBtn, {TextColor3=C.dim,BackgroundTransparency=1}, 0.25) end
        end)
        vBtn.MouseEnter:Connect(function()
            anim(vBtn, {TextColor3=C.text,BackgroundTransparency=0.92}, 0.18)
            if W.ActiveTab ~= Tab then anim(vInd, {Size=UDim2.new(0,2,0.3,0),BackgroundTransparency=0.5}, 0.22) end
        end)
        vBtn.MouseLeave:Connect(function()
            if W.ActiveTab ~= Tab then
                anim(vBtn, {TextColor3=C.dim,BackgroundTransparency=1}, 0.25)
                anim(vInd, {Size=UDim2.new(0,0,0.5,0),BackgroundTransparency=1}, 0.25)
            end
        end)

        table.insert(self.Tabs, Tab)
        if #self.Tabs == 1 then W:SelectTab(Tab) end

        function Tab:AddLeftGroupbox(n)   return self:AddGroupbox(n,"Left")   end
        function Tab:AddRightGroupbox(n)  return self:AddGroupbox(n,"Right")  end
        function Tab:AddCenterGroupbox(n) return self:AddGroupbox(n,"Center") end

        function Tab:AddGroupbox(gName, side)
            local GB = {Name=gName, Tab=self, Side=side, _n=0}
            local win = self.Window
            local parent

            if side == "Center" then
                if not self.CenterCol then
                    local cc = Instance.new("Frame"); cc.Name="Center"; cc.Size=UDim2.new(1,0,0,0)
                    cc.AutomaticSize=Enum.AutomaticSize.Y; cc.BackgroundTransparency=1; cc.Parent=self.Cols
                    local ccl = Instance.new("UIListLayout"); ccl.Padding=UDim.new(0,8)
                    ccl.SortOrder=Enum.SortOrder.LayoutOrder
                    ccl.HorizontalAlignment=Enum.HorizontalAlignment.Center; ccl.Parent=cc
                    self.Cols:FindFirstChildWhichIsA("UIListLayout").FillDirection=Enum.FillDirection.Vertical
                    self.LCol.Visible=false; self.RCol.Visible=false
                    self.CenterCol=cc
                    ccl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                        Page.CanvasSize=UDim2.new(0,0,0,ccl.AbsoluteContentSize.Y+12)
                    end)
                end
                parent = self.CenterCol
            else
                parent = side=="Left" and self.LCol or self.RCol
            end

            -- Section card: surface bg with a soft top-to-bottom shade
            local Sec = Instance.new("Frame"); Sec.Name = gName
            Sec.Size = side=="Center" and UDim2.new(0.95,0,0,0) or UDim2.new(1,0,0,0)
            Sec.AutomaticSize = Enum.AutomaticSize.Y; Sec.BackgroundColor3 = C.surface
            Sec.BorderSizePixel = 0; Sec.Parent = parent
            corner(Sec, S.radius); pad(Sec, S.secPad, S.secPad, S.secPad, S.secPad)
            local secGrad = Instance.new("UIGradient"); secGrad.Rotation = 90
            secGrad.Color = ColorSequence.new(Color3.new(1,1,1), Color3.fromRGB(205,205,210)); secGrad.Parent = Sec

            local SL = Instance.new("UIListLayout"); SL.Padding = UDim.new(0,7); SL.SortOrder = Enum.SortOrder.LayoutOrder; SL.Parent = Sec

            -- Group title with accent dot
            local STRow = Instance.new("Frame"); STRow.Size = UDim2.new(1,0,0,18)
            STRow.BackgroundTransparency=1; STRow.LayoutOrder=1; STRow.Parent=Sec
            local STDot = Instance.new("Frame"); STDot.Size=UDim2.new(0,4,0,4); STDot.Position=UDim2.new(0,0,0.5,-2)
            STDot.BackgroundColor3=C.accent; STDot.BackgroundTransparency=0.35; STDot.BorderSizePixel=0; STDot.Parent=STRow; corner(STDot,2)
            local ST = Instance.new("TextLabel"); ST.Size=UDim2.new(1,-8,1,0); ST.Position=UDim2.new(0,8,0,0)
            ST.BackgroundTransparency=1; ST.Text=gName; ST.TextColor3=C.sub
            ST.TextSize=S.txtXs; ST.Font=Enum.Font.GothamBold
            ST.TextXAlignment=Enum.TextXAlignment.Left; ST.Parent=STRow

            -- The dot lights up while the pointer is over the card
            Sec.MouseEnter:Connect(function() anim(STDot, {BackgroundTransparency=0}, 0.25);    anim(ST, {TextColor3=C.text}, 0.25) end)
            Sec.MouseLeave:Connect(function() anim(STDot, {BackgroundTransparency=0.35}, 0.35); anim(ST, {TextColor3=C.sub},  0.35) end)

            GB.Sec=Sec; GB.SL=SL
            local function nxt() GB._n=GB._n+1; return GB._n+1 end

            -- ══ TOGGLE ══  (the whole row is clickable)
            function GB:AddToggle(flag, opts)
                opts = opts or {}; local on = opts.Default or false
                win.Flags[flag] = on

                local R = Instance.new("TextButton"); R.Size=UDim2.new(1,0,0,S.elemH); R.BackgroundTransparency=1
                R.Text=""; R.AutoButtonColor=false; R.LayoutOrder=nxt(); R.Parent=Sec
                local L = Instance.new("TextLabel"); L.Size=UDim2.new(1,-(S.pillW+8),1,0); L.BackgroundTransparency=1
                L.Text=opts.Text or flag; L.TextColor3=C.sub; L.TextSize=S.txt
                L.Font=Enum.Font.GothamMedium; L.TextXAlignment=Enum.TextXAlignment.Left; L.Parent=R

                local B = Instance.new("Frame")
                B.Size=UDim2.new(0,S.pillW,0,S.pillH); B.Position=UDim2.new(1,-S.pillW,0.5,-S.pillH/2)
                B.BackgroundColor3=C.none; B.BorderSizePixel=0; B.Parent=R; corner(B,S.pillH)

                -- Glow halo around the pill when active
                local pillGlow = Instance.new("Frame")
                pillGlow.Size=UDim2.new(1,10,1,10); pillGlow.Position=UDim2.new(0,-5,0,-5)
                pillGlow.BackgroundColor3=C.accent; pillGlow.BackgroundTransparency=1; pillGlow.BorderSizePixel=0
                pillGlow.ZIndex=0; pillGlow.Parent=B; corner(pillGlow, S.pillH+2)

                local Dot = Instance.new("Frame")
                Dot.Size=UDim2.new(0,S.knob,0,S.knob); Dot.AnchorPoint=Vector2.new(0,0.5); Dot.Position=UDim2.new(0,2,0.5,0)
                Dot.BackgroundColor3=C.sub; Dot.BorderSizePixel=0; Dot.ZIndex=2; Dot.Parent=B; corner(Dot,99)

                local ti = TweenInfo.new(0.34, QUINT, OUT)
                local hovering = false

                local function set(state, silent, instant)
                    on=state; win.Flags[flag]=state
                    TweenService:Create(Dot, ti, {
                        AnchorPoint      = Vector2.new(state and 1 or 0, 0.5),
                        Position         = UDim2.new(state and 1 or 0, state and -2 or 2, 0.5, 0),
                        BackgroundColor3 = state and Color3.new(1,1,1) or C.sub,
                    }):Play()
                    TweenService:Create(B, ti, {BackgroundColor3 = state and C.accent or (hovering and C.noneHi or C.none)}):Play()
                    TweenService:Create(pillGlow, ti, {BackgroundTransparency = state and 0.84 or 1}):Play()
                    anim(L, {TextColor3 = (state or hovering) and C.text or C.sub}, 0.22)
                    -- Knob stretches while it travels, then settles
                    if not instant then
                        anim(Dot, {Size=UDim2.new(0,S.knob+6,0,S.knob-2)}, 0.12)
                        task.delay(0.11, function() anim(Dot, {Size=UDim2.new(0,S.knob,0,S.knob)}, 0.32, BACK) end)
                    end
                    if not silent and opts.Callback then pcall(opts.Callback,state) end
                end
                R.MouseButton1Click:Connect(function() set(not on) end)
                R.MouseEnter:Connect(function()
                    hovering=true; anim(L, {TextColor3=C.text}, 0.18)
                    if not on then anim(B, {BackgroundColor3=C.noneHi}, 0.18) end
                end)
                R.MouseLeave:Connect(function()
                    hovering=false; anim(L, {TextColor3=on and C.text or C.sub}, 0.25)
                    if not on then anim(B, {BackgroundColor3=C.none}, 0.25) end
                end)
                set(on,true,true)
                local obj={Flag=flag}
                function obj:Set(v) set(v and true or false) end; function obj:Get() return on end
                win.Elements[flag]=obj; return obj
            end

            -- ══ BUTTON ══
            function GB:AddButton(opts)
                opts = opts or {}
                -- Fixed-size row in the list; the button scales inside it so the layout never shifts
                local R = Instance.new("Frame"); R.Size=UDim2.new(1,0,0,S.btnH); R.BackgroundTransparency=1
                R.LayoutOrder=nxt(); R.Parent=Sec
                local B = Instance.new("TextButton"); B.Size=UDim2.new(1,0,1,0)
                B.AnchorPoint=Vector2.new(0.5,0.5); B.Position=UDim2.new(0.5,0,0.5,0)
                B.BackgroundColor3=C.card; B.Text=opts.Text or "Button"; B.AutoButtonColor=false
                B.TextColor3=C.sub; B.TextSize=S.txtSm; B.Font=Enum.Font.GothamMedium
                B.ClipsDescendants=true; B.Parent=R
                corner(B,6)
                local str = stroke(B, C.stroke, 0.25)
                local sc  = Instance.new("UIScale"); sc.Parent=B

                B.MouseEnter:Connect(function()
                    anim(B,   {BackgroundColor3=C.cardHi, TextColor3=C.text}, 0.18)
                    anim(str, {Color=C.accent, Transparency=0.45}, 0.18)
                end)
                B.MouseLeave:Connect(function()
                    anim(B,   {BackgroundColor3=C.card, TextColor3=C.sub}, 0.28)
                    anim(str, {Color=C.stroke, Transparency=0.25}, 0.28)
                    anim(sc,  {Scale=1}, 0.2)
                end)
                B.MouseButton1Down:Connect(function() anim(sc, {Scale=0.965}, 0.1) end)
                B.MouseButton1Up:Connect(function()   anim(sc, {Scale=1}, 0.35, BACK) end)
                B.MouseButton1Click:Connect(function()
                    ripple(B,C.accent)
                    if opts.Func then pcall(opts.Func) end
                end)
                return B
            end

            -- ══ SLIDER ══
            function GB:AddSlider(flag, opts)
                opts = opts or {}
                local page = self.Tab.Page
                local mn,mx = opts.Min or 0, opts.Max or 100
                local val = math.clamp(opts.Default or mn, mn, mx)
                local sfx = opts.Suffix or ""
                win.Flags[flag] = val

                local R=Instance.new("Frame"); R.Size=UDim2.new(1,0,0,S.sliderH); R.BackgroundTransparency=1; R.LayoutOrder=nxt(); R.Parent=Sec
                local L=Instance.new("TextLabel"); L.Size=UDim2.new(0.7,0,0,16); L.BackgroundTransparency=1
                L.Text=opts.Text or flag; L.TextColor3=C.sub; L.TextSize=S.txtSm; L.Font=Enum.Font.GothamMedium; L.TextXAlignment=Enum.TextXAlignment.Left; L.Parent=R
                local V=Instance.new("TextLabel"); V.Size=UDim2.new(0.3,0,0,16); V.Position=UDim2.new(0.7,0,0,0); V.BackgroundTransparency=1
                V.Text=tostring(val)..sfx; V.TextColor3=C.accent; V.TextSize=S.txtSm; V.Font=Enum.Font.GothamBold; V.TextXAlignment=Enum.TextXAlignment.Right; V.Parent=R

                local trackY = S.sliderH - 10
                local Track=Instance.new("Frame"); Track.Size=UDim2.new(1,0,0,4); Track.Position=UDim2.new(0,0,0,trackY)
                Track.BackgroundColor3=C.none; Track.BorderSizePixel=0; Track.Parent=R; corner(Track,2)
                local Fill=Instance.new("Frame"); Fill.Size=UDim2.new(0,0,1,0); Fill.BackgroundColor3=Color3.new(1,1,1); Fill.BorderSizePixel=0; Fill.Parent=Track; corner(Fill,2)
                local fillGrad=Instance.new("UIGradient"); fillGrad.Color=ColorSequence.new{
                    ColorSequenceKeypoint.new(0,C.accentD), ColorSequenceKeypoint.new(1,C.accentL),
                }; fillGrad.Parent=Fill

                -- Thumb = zero-size anchor that moves; glow and knob are siblings so the glow sits BEHIND the knob
                local Thumb=Instance.new("Frame"); Thumb.Size=UDim2.new(0,0,0,0); Thumb.Position=UDim2.new(0,0,0.5,0)
                Thumb.BackgroundTransparency=1; Thumb.ZIndex=2; Thumb.Parent=Track
                local tGlow=Instance.new("Frame"); tGlow.Size=UDim2.new(0,16,0,16); tGlow.AnchorPoint=Vector2.new(0.5,0.5)
                tGlow.BackgroundColor3=C.accent; tGlow.BackgroundTransparency=1
                tGlow.BorderSizePixel=0; tGlow.ZIndex=1; tGlow.Parent=Thumb; corner(tGlow,99)
                local Knob=Instance.new("Frame"); Knob.Size=UDim2.new(0,10,0,10); Knob.AnchorPoint=Vector2.new(0.5,0.5)
                Knob.BackgroundColor3=Color3.new(1,1,1); Knob.BorderSizePixel=0; Knob.ZIndex=2; Knob.Parent=Thumb; corner(Knob,99)

                local mult = 10 ^ (opts.Decimals or 0)
                local function set(v,silent)
                    v=tonumber(v) or val
                    val=math.clamp(math.floor(v*mult+0.5)/mult,mn,mx); win.Flags[flag]=val
                    local p=mx>mn and (val-mn)/(mx-mn) or 0
                    V.Text=tostring(val)..sfx
                    anim(Fill,{Size=UDim2.new(p,0,1,0)},0.14)
                    anim(Thumb,{Position=UDim2.new(p,0,0.5,0)},0.14)
                    if not silent and opts.Callback then pcall(opts.Callback,val) end
                end

                local drag, hov = false, false
                local function look()
                    local sz = drag and 14 or (hov and 12 or 10)
                    local gl = drag and 26 or 16
                    anim(Knob,  {Size=UDim2.new(0,sz,0,sz)}, 0.25, BACK)
                    anim(tGlow, {Size=UDim2.new(0,gl,0,gl), BackgroundTransparency=drag and 0.72 or 1}, 0.25)
                    anim(L,     {TextColor3=(drag or hov) and C.text or C.sub}, 0.2)
                    anim(Track, {BackgroundColor3=(drag or hov) and C.noneHi or C.none}, 0.2)
                end
                local function fromInput(i)
                    local ap=Track.AbsolutePosition; local as=Track.AbsoluteSize
                    if as.X<=0 then return end
                    set(mn+math.clamp((i.Position.X-ap.X)/as.X,0,1)*(mx-mn))
                end
                local function isPress(i)
                    return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch
                end

                R.MouseEnter:Connect(function() hov=true;  look() end)
                R.MouseLeave:Connect(function() hov=false; look() end)
                R.InputBegan:Connect(function(i)
                    if isPress(i) then
                        -- Don't let the page scroll while the finger is moving the slider
                        drag=true; page.ScrollingEnabled=false; look(); fromInput(i)
                    end
                end)
                table.insert(win.Conns, UserInputService.InputEnded:Connect(function(i)
                    if drag and isPress(i) then drag=false; page.ScrollingEnabled=true; look() end
                end))
                table.insert(win.Conns, UserInputService.InputChanged:Connect(function(i)
                    if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                        fromInput(i)
                    end
                end))

                set(val,true)
                local obj={Flag=flag}
                function obj:Set(v) set(v) end; function obj:Get() return val end
                win.Elements[flag]=obj; return obj
            end

            -- ══ DROPDOWN ══
            function GB:AddDropdown(flag, opts)
                opts = opts or {}
                local items   = opts.Options or {}
                local isMulti = opts.Multi == true
                local MAXH    = 160
                local itemH   = isMobile and 28 or 22
                local selected
                if isMulti then
                    selected=(type(opts.Default)=="table") and opts.Default or {}
                else
                    selected=opts.Default or items[1] or ""
                end
                win.Flags[flag]=selected

                local R=Instance.new("Frame"); R.Size=UDim2.new(1,0,0,S.elemH); R.BackgroundTransparency=1; R.LayoutOrder=nxt(); R.ClipsDescendants=false; R.Parent=Sec
                local L=Instance.new("TextLabel"); L.Size=UDim2.new(0.5,0,1,0); L.BackgroundTransparency=1
                L.Text=opts.Text or flag; L.TextColor3=C.sub; L.TextSize=S.txtSm; L.Font=Enum.Font.GothamMedium; L.TextXAlignment=Enum.TextXAlignment.Left; L.Parent=R

                local B=Instance.new("TextButton"); B.Size=UDim2.new(0.5,0,1,0); B.Position=UDim2.new(0.5,0,0,0)
                B.BackgroundColor3=C.none; B.Text=""; B.AutoButtonColor=false; B.Parent=R
                corner(B,5)
                local Bstr=stroke(B, C.stroke, 0.3)

                local BT=Instance.new("TextLabel"); BT.Size=UDim2.new(1,-32,1,0); BT.Position=UDim2.new(0,10,0,0)
                BT.BackgroundTransparency=1; BT.TextColor3=C.text; BT.TextSize=S.txtXs; BT.Font=Enum.Font.GothamMedium
                BT.TextXAlignment=Enum.TextXAlignment.Left; BT.TextTruncate=Enum.TextTruncate.AtEnd; BT.Parent=B

                -- Chevron drawn with two bars so it can rotate (no font glyph / image needed)
                local Chev=Instance.new("Frame"); Chev.Size=UDim2.new(0,10,0,10); Chev.AnchorPoint=Vector2.new(0.5,0.5)
                Chev.Position=UDim2.new(1,-13,0.5,0); Chev.BackgroundTransparency=1; Chev.Parent=B
                local chevBars={}
                for _,sgn in ipairs({-1,1}) do
                    local bar=Instance.new("Frame"); bar.Size=UDim2.new(0,6,0,2); bar.AnchorPoint=Vector2.new(0.5,0.5)
                    bar.Position=UDim2.new(0.5,sgn*2,0.5,0); bar.Rotation=-sgn*45
                    bar.BackgroundColor3=C.sub; bar.BorderSizePixel=0; bar.Parent=Chev; corner(bar,1)
                    table.insert(chevBars, bar)
                end

                local List=Instance.new("Frame"); List.Size=UDim2.new(1,0,0,0); List.Position=UDim2.new(0,0,1,2)
                List.BackgroundColor3=C.card; List.BorderSizePixel=0; List.Visible=false
                List.ZIndex=200; List.ClipsDescendants=true; List.Parent=win.ScreenGui
                corner(List,6)
                local LStr=stroke(List, C.stroke, 1)

                local SF=Instance.new("ScrollingFrame"); SF.Size=UDim2.new(1,0,1,0)
                SF.BackgroundTransparency=1; SF.BorderSizePixel=0; SF.ScrollBarThickness=3
                SF.ScrollBarImageColor3=C.accent; SF.CanvasSize=UDim2.new(0,0,0,0); SF.ZIndex=51; SF.Parent=List
                hoverScroll(SF)
                local LL=Instance.new("UIListLayout"); LL.Padding=UDim.new(0,2); LL.SortOrder=Enum.SortOrder.LayoutOrder; LL.Parent=SF
                pad(SF,4,4,4,4)

                local function contentH()
                    return (#items>0 and (#items*(itemH+2)-2) or 0) + 8
                end
                local function isSel(item)
                    if isMulti then for _,v in ipairs(selected) do if v==item then return true end end; return false end
                    return selected==item
                end
                local function updateButtonText()
                    if isMulti then
                        local n=#selected
                        BT.Text = n==0 and "None" or n==1 and tostring(selected[1]) or n.." selected"
                    else
                        BT.Text = tostring(selected)
                    end
                end
                updateButtonText()

                local open, hov = false, false
                local function look()
                    local hot = open or hov
                    anim(B,    {BackgroundColor3=hot and C.noneHi or C.none}, 0.2)
                    anim(Bstr, {Color=open and C.accent or C.stroke, Transparency=open and 0.35 or 0.3}, 0.2)
                    anim(L,    {TextColor3=hot and C.text or C.sub}, 0.2)
                    anim(Chev, {Rotation=open and 180 or 0}, 0.35, QUINT)
                    for _,bar in ipairs(chevBars) do anim(bar, {BackgroundColor3=open and C.accent or (hov and C.text or C.sub)}, 0.2) end
                end
                B.MouseEnter:Connect(function() hov=true;  look() end)
                B.MouseLeave:Connect(function() hov=false; look() end)

                local function closeDropdown()
                    if not open then return end
                    open=false
                    if win._dd and win._dd.list==List then win._dd=nil end
                    anim(List,{Size=UDim2.new(0,List.AbsoluteSize.X,0,0)},0.2,QUART)
                    anim(LStr,{Transparency=1},0.15)
                    look()
                    task.delay(0.2,function() if not open then List.Visible=false end end)
                end

                -- Item colours: hover > selected > idle
                local function paint(IB, hovered, dur)
                    local sel=isSel(IB.Name)
                    anim(IB, {
                        BackgroundTransparency = hovered and 0.86 or (sel and 0.93 or 1),
                        TextColor3 = hovered and C.text or (sel and C.accent or C.sub),
                    }, dur or 0.15)
                    local dot=IB:FindFirstChild("_dot")
                    if dot then
                        anim(dot, {BackgroundColor3=sel and C.accent or C.dim, BackgroundTransparency=sel and 0 or 0.5}, dur or 0.15)
                    end
                end
                local function refreshColors()
                    for _,ch in ipairs(SF:GetChildren()) do
                        if ch:IsA("TextButton") then paint(ch, false) end
                    end
                end

                local function buildItems()
                    for _,ch in ipairs(SF:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
                    for _,i in ipairs(items) do
                        local ic=i
                        local IB=Instance.new("TextButton"); IB.Name=tostring(ic)
                        IB.Size=UDim2.new(1,-6,0,itemH); IB.BackgroundTransparency=1
                        IB.BackgroundColor3=C.accent; IB.Text=tostring(ic)
                        IB.TextColor3=C.sub; IB.TextXAlignment=Enum.TextXAlignment.Left
                        IB.TextSize=S.txtXs; IB.Font=Enum.Font.GothamMedium
                        IB.AutoButtonColor=false; IB.ZIndex=52; IB.Parent=SF; corner(IB,4); pad(IB,0,0,8,8)
                        if isMulti then
                            local dot=Instance.new("Frame"); dot.Name="_dot"
                            dot.Size=UDim2.new(0,7,0,7); dot.Position=UDim2.new(1,-7,0.5,-3)
                            dot.BackgroundColor3=C.dim; dot.BackgroundTransparency=0.5
                            dot.BorderSizePixel=0; dot.ZIndex=53; dot.Parent=IB; corner(dot,2)
                        end
                        paint(IB, false, 0)
                        IB.MouseEnter:Connect(function() paint(IB, true) end)
                        IB.MouseLeave:Connect(function() paint(IB, false, 0.22) end)
                        IB.MouseButton1Click:Connect(function()
                            if isMulti then
                                local found=false
                                for idx,v in ipairs(selected) do if v==ic then table.remove(selected,idx); found=true; break end end
                                if not found then table.insert(selected,ic) end
                                win.Flags[flag]=selected; refreshColors(); paint(IB, true); updateButtonText()
                                if opts.Callback then pcall(opts.Callback,selected) end
                            else
                                selected=ic; win.Flags[flag]=ic
                                refreshColors(); updateButtonText(); closeDropdown()
                                if opts.Callback then pcall(opts.Callback,ic) end
                            end
                        end)
                    end
                    SF.CanvasSize=UDim2.new(0,0,0,contentH())
                end
                buildItems()

                B.MouseButton1Click:Connect(function()
                    if open then closeDropdown(); return end
                    win:CloseDropdown()
                    open=true; win._dd={close=closeDropdown,list=List,btn=B}
                    local inset=GuiService:GetGuiInset()
                    local absPos=B.AbsolutePosition; local absSize=B.AbsoluteSize
                    local h=math.min(contentH(),MAXH)
                    local top=absPos.Y+inset.Y
                    -- Open upward when there is no room below
                    local up=(top+absSize.Y+3+h > getVP().Y-4) and (top-3-h > 0)
                    List.AnchorPoint=Vector2.new(0, up and 1 or 0)
                    List.Position=UDim2.new(0,absPos.X+inset.X,0, up and top-3 or top+absSize.Y+3)
                    List.Size=UDim2.new(0,absSize.X,0,0); List.Visible=true
                    SF.CanvasSize=UDim2.new(0,0,0,contentH())
                    anim(List,{Size=UDim2.new(0,absSize.X,0,h)},0.32,QUINT)
                    anim(LStr,{Transparency=0.1},0.2)
                    look()
                end)

                local obj={Flag=flag}
                function obj:Get() return selected end
                function obj:Set(v)
                    if isMulti then v=(type(v)=="table") and v or {} else v=tostring(v) end
                    selected=v; win.Flags[flag]=v; updateButtonText(); refreshColors()
                    if opts.Callback then pcall(opts.Callback,v) end
                end
                win.Elements[flag]=obj
                return obj
            end

            -- ══ LABEL ══
            function GB:AddLabel(text, opts)
                opts=opts or {}
                local L=Instance.new("TextLabel"); L.Size=UDim2.new(1,0,0,0)
                L.AutomaticSize=Enum.AutomaticSize.Y; L.BackgroundTransparency=1
                L.Text=text or ""; L.TextColor3=opts.Color or C.dim
                L.TextSize=S.txtSm; L.Font=Enum.Font.GothamMedium
                L.TextXAlignment=Enum.TextXAlignment.Left; L.TextWrapped=true
                L.LayoutOrder=nxt(); L.Parent=Sec
                local obj={}
                function obj:Set(t)    L.Text=t end
                function obj:SetText(t) L.Text=t end
                return obj
            end

            -- ══ INPUT ══
            function GB:AddInput(flag, opts)
                opts=opts or {}
                win.Flags[flag]=opts.Default or ""
                local R=Instance.new("Frame"); R.Size=UDim2.new(1,0,0,S.elemH); R.BackgroundTransparency=1; R.LayoutOrder=nxt(); R.Parent=Sec
                local L=Instance.new("TextLabel"); L.Size=UDim2.new(0.5,0,1,0); L.BackgroundTransparency=1
                L.Text=opts.Text or flag; L.TextColor3=C.sub; L.TextSize=S.txtSm; L.Font=Enum.Font.GothamMedium; L.TextXAlignment=Enum.TextXAlignment.Left; L.Parent=R
                local Box=Instance.new("TextBox"); Box.Size=UDim2.new(0.5,0,1,0); Box.Position=UDim2.new(0.5,0,0,0)
                Box.BackgroundColor3=C.none; Box.Text=opts.Default or ""; Box.PlaceholderText=opts.Placeholder or "..."
                Box.TextColor3=C.text; Box.PlaceholderColor3=C.dim; Box.TextSize=S.txtXs; Box.Font=Enum.Font.GothamMedium
                Box.TextXAlignment=Enum.TextXAlignment.Left; Box.ClearTextOnFocus=false
                Box.ClipsDescendants=true; Box.TextTruncate=Enum.TextTruncate.AtEnd; Box.Parent=R
                corner(Box,5); pad(Box,0,0,10,10)
                local Str=stroke(Box, C.stroke, 0.3)

                local focused, hov = false, false
                local function look()
                    anim(Str, {Color=focused and C.accent or C.stroke, Transparency=focused and 0.1 or 0.3}, 0.2)
                    anim(Box, {BackgroundColor3=(focused or hov) and C.noneHi or C.none}, 0.2)
                    anim(L,   {TextColor3=(focused or hov) and C.text or C.sub}, 0.2)
                end
                Box.MouseEnter:Connect(function() hov=true;  look() end)
                Box.MouseLeave:Connect(function() hov=false; look() end)
                Box.Focused:Connect(function() focused=true; look() end)
                Box.FocusLost:Connect(function()
                    focused=false; look()
                    win.Flags[flag]=Box.Text
                    if opts.Callback then pcall(opts.Callback,Box.Text) end
                end)
                win.Elements[flag]={Flag=flag, Set=function(_,v)
                    Box.Text=tostring(v); win.Flags[flag]=Box.Text
                    if opts.Callback then pcall(opts.Callback,Box.Text) end
                end, Get=function() return Box.Text end}
                return Box
            end

            -- ══ KEYBIND ══
            function GB:AddKeybind(flag, opts)
                opts=opts or {}
                local key=opts.Default or Enum.KeyCode.Unknown
                local binding=false
                win.Flags[flag]=key
                local R=Instance.new("Frame"); R.Size=UDim2.new(1,0,0,S.elemH); R.BackgroundTransparency=1; R.LayoutOrder=nxt(); R.Parent=Sec
                local L=Instance.new("TextLabel"); L.Size=UDim2.new(1,-68,1,0); L.BackgroundTransparency=1
                L.Text=opts.Text or flag; L.TextColor3=C.sub; L.TextSize=S.txtSm; L.Font=Enum.Font.GothamMedium; L.TextXAlignment=Enum.TextXAlignment.Left; L.Parent=R
                local bkH=isMobile and 22 or 18
                local Bk=Instance.new("TextButton"); Bk.Size=UDim2.new(0,60,0,bkH); Bk.Position=UDim2.new(1,-60,0.5,-bkH/2)
                Bk.BackgroundColor3=C.none; Bk.TextSize=S.txtXs; Bk.Font=Enum.Font.GothamBold; Bk.TextColor3=C.sub
                Bk.AutoButtonColor=false; Bk.Parent=R
                corner(Bk,4)
                local Str=stroke(Bk, C.stroke, 0.3)

                local hov=false
                local function upd()
                    local n=(key and (key.Name or tostring(key))) or "None"
                    Bk.Text=binding and "..." or (n=="Unknown" and "None" or n)
                    anim(Bk,  {TextColor3=binding and C.accent or (hov and C.text or C.sub),
                               BackgroundColor3=(binding or hov) and C.noneHi or C.none}, 0.18)
                    anim(Str, {Color=binding and C.accent or C.stroke, Transparency=binding and 0.1 or 0.3}, 0.18)
                    anim(L,   {TextColor3=(binding or hov) and C.text or C.sub}, 0.18)
                end
                Bk.MouseEnter:Connect(function() hov=true;  upd() end)
                Bk.MouseLeave:Connect(function() hov=false; upd() end)
                Bk.MouseButton1Click:Connect(function() binding=not binding; upd() end)
                table.insert(win.Conns, UserInputService.InputBegan:Connect(function(i,gp)
                    if binding and not gp then
                        if i.KeyCode==Enum.KeyCode.Escape then binding=false; upd()
                        elseif i.UserInputType==Enum.UserInputType.Keyboard then
                            key=i.KeyCode; win.Flags[flag]=key; binding=false; upd()
                            if opts.Callback then pcall(opts.Callback,key) end
                        end
                    end
                end))
                win.Elements[flag]={Flag=flag, Set=function(_,k)
                    if typeof(k)~="EnumItem" then return end
                    key=k; win.Flags[flag]=k; binding=false; upd()
                    if opts.Callback then pcall(opts.Callback,k) end
                end, Get=function() return key end}
                upd(); return Bk
            end

            -- ══ SEPARATOR ══
            function GB:AddSeparator()
                local S2=Instance.new("Frame"); S2.Size=UDim2.new(1,0,0,1)
                S2.BackgroundColor3=C.none; S2.BorderSizePixel=0; S2.LayoutOrder=nxt(); S2.Parent=Sec
                -- fades out to both ends
                local g=Instance.new("UIGradient"); g.Transparency=NumberSequence.new{
                    NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(0.2,0),
                    NumberSequenceKeypoint.new(0.8,0), NumberSequenceKeypoint.new(1,1),
                }; g.Parent=S2
                return S2
            end

            return GB
        end
        return Tab
    end

    -- ══════════════════════════════════════
    -- SELECT TAB
    -- ══════════════════════════════════════
    function W:SelectTab(tab)
        if _sw then return end
        local prev=self.ActiveTab
        if prev==tab then return end
        self:CloseDropdown()

        for _,t in ipairs(self.Tabs) do
            if t~=tab then
                t.Page.Visible=false
                anim(t.hBtn,{TextColor3=C.dim,BackgroundTransparency=1},0.25)
                anim(t.vBtn,{TextColor3=C.dim,BackgroundTransparency=1},0.25)
                anim(t.vInd,{Size=UDim2.new(0,0,0.5,0),BackgroundTransparency=1},0.25)
            end
        end

        tab.Page.Visible=true; self.PageTitle.Text=string.upper(tab.Name)
        anim(tab.hBtn,{TextColor3=C.text,BackgroundTransparency=0.92},0.25)
        anim(tab.vBtn,{TextColor3=C.text,BackgroundTransparency=0.92},0.25)
        anim(tab.vInd,{Size=UDim2.new(0,2,0.5,0),BackgroundTransparency=0},0.35,QUINT)
        self.ActiveTab=tab

        -- New page slides in from the side it lives on (or from below/above in sidebar mode) while it fades in
        if prev then
            local dir=((table.find(self.Tabs,tab) or 1) > (table.find(self.Tabs,prev) or 1)) and 1 or -1
            tab.Page.Position=self.SidebarMode and UDim2.new(0,0,0,16*dir) or UDim2.new(0,22*dir,0,0)
            anim(tab.Page,{Position=UDim2.new(0,0,0,0)},0.42,QUINT)
            Fade.BackgroundTransparency=0.05
            anim(Fade,{BackgroundTransparency=1},0.36,SINE)
        end

        if not self.SidebarMode then
            if prev then placeInd(tab, true) else task.defer(function() placeInd(tab, false) end) end
        end
    end

    -- ══════════════════════════════════════
    -- CONFIG
    -- ══════════════════════════════════════
    function W:SaveConfig(name)
        if not writefile then Library:Notify({Title="Error",Message="File system not supported",Type="error"}); return end
        local d={}
        for k,v in pairs(self.Flags) do
            local t=type(v)
            if t=="boolean" or t=="number" or t=="string" or t=="table" then d[k]=v
            elseif typeof(v)=="EnumItem" then d[k]={__key=v.Name} end
        end
        local ok,err=pcall(function() writefile((name or "config")..".json",game:GetService("HttpService"):JSONEncode(d)) end)
        if ok then Library:Notify({Title="Saved",  Message=(name or "config")..".json",Type="success"})
        else       Library:Notify({Title="Error",  Message=tostring(err),               Type="error"})   end
    end
    function W:LoadConfig(name)
        if not readfile then Library:Notify({Title="Error",Message="File system not supported",Type="error"}); return end
        local ok,r=pcall(function() return game:GetService("HttpService"):JSONDecode(readfile((name or "config")..".json")) end)
        if ok and r then
            for k,v in pairs(r) do
                if type(v)=="table" and v.__key then
                    local okK,kc=pcall(function() return Enum.KeyCode[v.__key] end)
                    v=okK and kc or Enum.KeyCode.Unknown
                end
                local e=self.Elements[k]
                if e then pcall(function() e:Set(v) end) else self.Flags[k]=v end
            end
            Library:Notify({Title="Loaded",Message=(name or "config")..".json",Type="success"})
        else
            Library:Notify({Title="Error", Message="Config not found",          Type="error"})
        end
    end

    -- ══════════════════════════════════════
    -- DESTROY
    -- ══════════════════════════════════════
    function W:Destroy(instant)
        self:CloseDropdown()
        for _,c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
        self.Conns={}
        if getgenv then
            if getgenv().SimpleUI==SG then getgenv().SimpleUI=nil end
            if getgenv().SimpleUIWindow==self then getgenv().SimpleUIWindow=nil end
        end
        if instant then pcall(function() SG:Destroy() end); return end
        pcall(function()
            anim(MainScale,{Scale=0.01},0.24,QUART,IN)
            anim(Shadow,{ImageTransparency=1},0.14)
        end)
        task.delay(0.26,function() pcall(function() SG:Destroy() end) end)
    end

    return W
end

