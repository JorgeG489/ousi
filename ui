local C = {
    bg      = Color3.fromRGB(8,   8,   8),
    bgTop   = Color3.fromRGB(17,  17,  20),
    surface = Color3.fromRGB(18,  18,  18),
    card    = Color3.fromRGB(26,  26,  26),
    cardHi  = Color3.fromRGB(36,  36,  40),

    accent  = Color3.fromRGB(255, 51,  119),
    accentL = Color3.fromRGB(255, 102, 153),
    accentD = Color3.fromRGB(230, 0,   82),

    text    = Color3.fromRGB(230, 230, 235),
    sub     = Color3.fromRGB(100, 100, 106),
    dim     = Color3.fromRGB(51,  51,  56),

    line    = Color3.fromRGB(26,  26,  30),
    none    = Color3.fromRGB(36,  36,  40),
    noneHi  = Color3.fromRGB(50,  50,  56),
    stroke  = Color3.fromRGB(42,  42,  48),
}

local QUART, QUINT = Enum.EasingStyle.Quart, Enum.EasingStyle.Quint
local SINE, BACK   = Enum.EasingStyle.Sine,  Enum.EasingStyle.Back
local LINEAR       = Enum.EasingStyle.Linear
local OUT, IN, INOUT = Enum.EasingDirection.Out, Enum.EasingDirection.In, Enum.EasingDirection.InOut

-- Quart Out ≈ frontend power2.out
local function anim(inst, props, dur, style, dir)
    local t = TweenService:Create(inst,
        TweenInfo.new(dur or 0.22, style or QUART, dir or OUT),
        props)
    t:Play(); return t
end

local function corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 6); c.Parent = p
end

local function pad(p, t, b, l, r)
    local pd = Instance.new("UIPadding")
    pd.PaddingTop    = UDim.new(0, t or 0); pd.PaddingBottom = UDim.new(0, b or 0)
    pd.PaddingLeft   = UDim.new(0, l or 0); pd.PaddingRight  = UDim.new(0, r or 0)
    pd.Parent = p
end

-- Border mode: without it a UIStroke on a text object outlines the TEXT (looks blurry)
local function stroke(p, col, tr)
    local s = Instance.new("UIStroke"); s.Color = col or C.stroke; s.Thickness = 1
    s.Transparency = tr or 0; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p
    return s
end

local function ripple(btn, col)
    if not btn or not btn.AbsoluteSize then return end
    local mp = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
    local r  = Instance.new("Frame")
    r.Position = UDim2.new(0, mp.X - btn.AbsolutePosition.X, 0, mp.Y - btn.AbsolutePosition.Y)
    r.AnchorPoint = Vector2.new(0.5, 0.5)
    r.BackgroundColor3 = col or Color3.new(1,1,1)
    r.BackgroundTransparency = 0.6; r.BorderSizePixel = 0
    r.ZIndex = btn.ZIndex + 10; r.Parent = btn; corner(r, 99)
    local mx = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.5
    anim(r, {Size = UDim2.new(0,mx,0,mx), BackgroundTransparency = 1}, 0.55, QUINT)
    task.delay(0.58, function() pcall(function() r:Destroy() end) end)
end

local function hoverScroll(sf)
    sf.ScrollBarImageTransparency = 0.85
    sf.MouseEnter:Connect(function()  anim(sf, {ScrollBarImageTransparency = 0.1},  0.2) end)
    sf.MouseLeave:Connect(function()  anim(sf, {ScrollBarImageTransparency = 0.85}, 0.3) end)
end

