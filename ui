local _ni = 0

function Library:Notify(opts)
    opts = opts or {}; _ni = _ni + 1
    local acc = ({
        success = Color3.fromRGB(74,222,128),
        warning = Color3.fromRGB(250,189,47),
        error   = Color3.fromRGB(248,113,113),
        info    = C.accent,
    })[(opts.Type or "info"):lower()] or C.accent
    local dur  = opts.Duration or 3.5
    local msg  = opts.Message or ""
    local dead = false

    -- Card height follows the wrapped message (up to 3 lines)
    local mh = 0
    if msg ~= "" then
        local ok, sz = pcall(function()
            return TextService:GetTextSize(msg, 11, Enum.Font.GothamMedium, Vector2.new(NOTIF_W-30, 200))
        end)
        mh = math.clamp(ok and sz.Y or 13, 13, 40)
    end
    local h   = msg ~= "" and (38 + mh) or 36
    local GAP = 6

    -- The wrapper lives in the list (its height animates so the stack moves smoothly);
    -- the card slides inside it, since a UIListLayout ignores Position tweens.
    local wrap = Instance.new("Frame"); wrap.Size = UDim2.new(1,0,0,0); wrap.BackgroundTransparency = 1
    wrap.LayoutOrder = _ni; wrap.Parent = _nH

    local f = Instance.new("TextButton"); f.Size = UDim2.new(1,0,0,h); f.AnchorPoint = Vector2.new(0,1)
    f.Position = UDim2.new(1,32,1,0); f.BackgroundColor3 = C.card; f.BorderSizePixel = 0
    f.Text = ""; f.AutoButtonColor = false; f.Parent = wrap; corner(f, 8)
    stroke(f, C.stroke, 0.2)

    local bar = Instance.new("Frame"); bar.Size = UDim2.new(0,2,1,-18); bar.Position = UDim2.new(0,8,0,9)
    bar.BackgroundColor3 = acc; bar.BorderSizePixel = 0; bar.Parent = f; corner(bar, 1)

    local tl = Instance.new("TextLabel"); tl.Size = UDim2.new(1,-30,0,16); tl.Position = UDim2.new(0,18,0,9)
    tl.BackgroundTransparency = 1; tl.Text = opts.Title or ""; tl.TextColor3 = C.text
    tl.TextSize = 12; tl.Font = Enum.Font.GothamBold; tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.TextTruncate = Enum.TextTruncate.AtEnd; tl.Parent = f

    if msg ~= "" then
        local ml = Instance.new("TextLabel"); ml.Size = UDim2.new(1,-30,0,mh); ml.Position = UDim2.new(0,18,0,27)
        ml.BackgroundTransparency = 1; ml.Text = msg; ml.TextColor3 = C.sub
        ml.TextSize = 11; ml.Font = Enum.Font.GothamMedium; ml.TextXAlignment = Enum.TextXAlignment.Left
        ml.TextYAlignment = Enum.TextYAlignment.Top; ml.TextWrapped = true
        ml.TextTruncate = Enum.TextTruncate.AtEnd; ml.Parent = f
    end

    -- Time-left bar
    local prog = Instance.new("Frame"); prog.Size = UDim2.new(1,-36,0,2); prog.Position = UDim2.new(0,18,1,-5)
    prog.BackgroundColor3 = acc; prog.BackgroundTransparency = 0.6; prog.BorderSizePixel = 0; prog.Parent = f; corner(prog, 1)
    anim(prog, {Size = UDim2.new(0,0,0,2)}, dur, LINEAR)

    local function kill()
        if dead then return end; dead = true
        anim(f, {Position = UDim2.new(1,32,1,0)}, 0.3, QUART, IN)
        task.wait(0.28)
        anim(wrap, {Size = UDim2.new(1,0,0,0)}, 0.26, QUINT)
        task.wait(0.28); pcall(function() wrap:Destroy() end)
    end
    f.MouseButton1Click:Connect(kill)

    anim(wrap, {Size = UDim2.new(1,0,0,h+GAP)}, 0.3, QUINT)
    anim(f, {Position = UDim2.new(0,0,1,0)}, 0.5, QUINT)
    task.delay(dur, kill)
end

-- ══════════════════════════════════════════
-- WINDOW
-- ══════════════════════════════════════════
function Library:CreateWindow(options)
    options = options or {}

    -- A key window is already on screen (accepted key, waiting for the tabs): reuse it instead of
    -- building a new one. The caller adds its tabs as usual and the window unlocks right after.
    local prev = getgenv and getgenv().SimpleUIWindow
    if prev and prev.Locked and prev.KeyValid and not options.KeySystem then
        task.defer(function() prev:Unlock() end)
        return prev
    end

    local W = {Flags={}, Elements={}, Conns={}, Tabs={}, ActiveTab=nil, Minimized=false, SidebarMode=false, Visible=true}
    local title      = options.Title or "UI"
    local subtitle   = options.Subtitle or ""
    local toggleKey  = options.ToggleKeybind or Enum.KeyCode.RightShift

    -- Mobile-adaptive sizing: clamp to viewport, fill screen on phones
    local function computeSize(req)
        local vp = getVP()
        if isMobile then
            if vp.X < 540 then
                -- Phone: near full screen
                return UDim2.fromOffset(vp.X - 10, vp.Y - 50)
            else
                -- Tablet: generous but not full
                return UDim2.fromOffset(
                    math.min(vp.X - 28, req and req.X.Offset or 580),
                    math.min(vp.Y - 50, req and req.Y.Offset or 480)
                )
            end
        end
        return req or UDim2.fromOffset(620, 440)
    end

    local defSz  = computeSize(options.Size)
    local sideSz = computeSize(options.SidebarSize or (isMobile and defSz or UDim2.fromOffset(780,500)))

    -- Key system: the window starts as a small key prompt and morphs into the full window on W:Unlock()
    local KS = options.KeySystem
    W.Locked = KS and true or false
    local kFieldH, kBtnH = S.elemH + 10, S.btnH + 4
    local kFieldY = 38
    local kBtnY   = kFieldY + kFieldH + 10
    local kStatY  = kBtnY + kBtnH + 8
    local kPanelH = kStatY + 14 + 14
    local keySz = UDim2.fromOffset(
        isMobile and math.min(getVP().X - 20, 340) or 340,
        S.headerH + kPanelH)

    -- Replace any previous instance (and its connections)
    if getgenv then
        local oldW = getgenv().SimpleUIWindow
        if oldW then pcall(function() oldW:Destroy(true) end) end
        local oldG = getgenv().SimpleUI
        if oldG then pcall(function() oldG:Destroy() end) end
    end

    local SG = Instance.new("ScreenGui"); SG.Name = "SimpleUI"; SG.ResetOnSpawn = false
    SG.IgnoreGuiInset = true; SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    SG.DisplayOrder = 10; SG.Parent = PlayerGui
    if getgenv then getgenv().SimpleUI = SG; getgenv().SimpleUIWindow = W end

    -- Main = sized/dragged holder (doesn't clip, so the shadow shows); Body = clipped window
    local Main = Instance.new("Frame"); Main.Name = "MainFrame"
    Main.Size = W.Locked and keySz or defSz; Main.Position = UDim2.new(0.5,0,0.5,0); Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.BackgroundTransparency = 1; Main.BorderSizePixel = 0; Main.Parent = SG

    -- Every open / close / hide animation runs on this scale: the whole window moves as one piece
    local MainScale = Instance.new("UIScale"); MainScale.Scale = 0.86; MainScale.Parent = Main

    -- Drop shadow
    local Shadow = Instance.new("ImageLabel"); Shadow.BackgroundTransparency = 1
    Shadow.Position = UDim2.new(0,-18,0,-18); Shadow.Size = UDim2.new(1,36,1,36)
    Shadow.Image = "rbxassetid://5554236805"; Shadow.ImageColor3 = Color3.new(0,0,0)
    Shadow.ImageTransparency = 1; Shadow.ScaleType = Enum.ScaleType.Slice
    Shadow.SliceCenter = Rect.new(23,23,273,273); Shadow.ZIndex = 0; Shadow.Parent = Main

    local Body = Instance.new("Frame"); Body.Name = "Body"; Body.Size = UDim2.new(1,0,1,0)
    Body.BackgroundColor3 = Color3.new(1,1,1); Body.BorderSizePixel = 0
    Body.ClipsDescendants = true; Body.ZIndex = 1; Body.Parent = Main
    corner(Body, 10)
    local bodyGrad = Instance.new("UIGradient"); bodyGrad.Rotation = 90
    bodyGrad.Color = ColorSequence.new(C.bgTop, C.bg); bodyGrad.Parent = Body

    -- Hairline border with a faint accent tint on the top-left
    local bodyStr = stroke(Body, Color3.new(1,1,1), 0)
    local strGrad = Instance.new("UIGradient"); strGrad.Rotation = 55
    strGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0,    Color3.fromRGB(92, 34, 56)),
        ColorSequenceKeypoint.new(0.4,  C.none),
        ColorSequenceKeypoint.new(1,    C.line),
    }; strGrad.Parent = bodyStr

    -- Open: pop in
    task.spawn(function()
        task.wait()
        anim(MainScale, {Scale = 1}, 0.55, BACK)
        anim(Shadow, {ImageTransparency = 0.35}, 0.5)
    end)
    local fullSz = defSz

    -- Show / hide with animation (toggle key, close dot, mobile reopen)
    local _visTok = 0
    function W:SetVisible(v)
        v = v and true or false
        if v == self.Visible then return end
        self.Visible = v; _visTok = _visTok + 1
        local tok = _visTok
        self:CloseDropdown()
        if v then
            Main.Visible = true
            anim(MainScale, {Scale = 1}, 0.42, BACK)
            anim(Shadow, {ImageTransparency = 0.35}, 0.35)
        else
            anim(MainScale, {Scale = 0.01}, 0.24, QUART, IN)
            anim(Shadow, {ImageTransparency = 1}, 0.14)
            task.delay(0.25, function() if tok == _visTok then Main.Visible = false end end)
        end
    end

    -- ── Header ──────────────────────────────
    local hH = S.headerH
    local H = Instance.new("Frame"); H.Name = "Header"; H.Size = UDim2.new(1,0,0,hH)
    H.BackgroundTransparency = 1; H.BorderSizePixel = 0; H.ZIndex = 10; H.Parent = Body

    -- Header line: accent in the middle, fading out to the sides
    local HL = Instance.new("Frame"); HL.Size = UDim2.new(1,-20,0,1); HL.Position = UDim2.new(0,10,1,0)
    HL.BackgroundColor3 = Color3.new(1,1,1); HL.BorderSizePixel = 0; HL.ZIndex = 10; HL.Parent = H
    local hlGrad = Instance.new("UIGradient")
    hlGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0,   C.none),
        ColorSequenceKeypoint.new(0.5, C.accentD),
        ColorSequenceKeypoint.new(1,   C.none),
    }
    hlGrad.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0,   1),
        NumberSequenceKeypoint.new(0.5, 0.35),
        NumberSequenceKeypoint.new(1,   1),
    }; hlGrad.Parent = HL

    -- Brand dot + breathing glow
    local brandDot = Instance.new("Frame")
    brandDot.Size = UDim2.new(0,7,0,7); brandDot.Position = UDim2.new(0,14,0.5,-3)
    brandDot.BackgroundColor3 = C.accent; brandDot.BorderSizePixel = 0; brandDot.ZIndex = 10; brandDot.Parent = H; corner(brandDot, 4)
    local dotGlow = Instance.new("Frame")
    dotGlow.Size = UDim2.new(0,15,0,15); dotGlow.AnchorPoint = Vector2.new(0.5,0.5); dotGlow.Position = UDim2.new(0.5,0,0.5,0)
    dotGlow.BackgroundColor3 = C.accent; dotGlow.BackgroundTransparency = 0.68
    dotGlow.BorderSizePixel = 0; dotGlow.ZIndex = brandDot.ZIndex-1; dotGlow.Parent = brandDot; corner(dotGlow, 99)
    TweenService:Create(dotGlow, TweenInfo.new(1.7, SINE, INOUT, -1, true),
        {Size = UDim2.new(0,25,0,25), BackgroundTransparency = 0.93}):Play()

    -- Subtitle
    local yBase = subtitle ~= "" and (hH/2 - 14) or (hH/2 - 8)
    if subtitle ~= "" then
        local subLbl = Instance.new("TextLabel")
        subLbl.Size = UDim2.new(0,200,0,10); subLbl.Position = UDim2.new(0,30,0,yBase)
        subLbl.BackgroundTransparency = 1; subLbl.Text = subtitle
        subLbl.TextColor3 = C.accent; subLbl.TextSize = 9
        subLbl.Font = Enum.Font.RobotoMono; subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.ZIndex = 10; subLbl.Parent = H
        yBase = yBase + 11
    end

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(0,220,0,16); titleLbl.Position = UDim2.new(0,30,0,yBase)
    titleLbl.BackgroundTransparency = 1; titleLbl.Text = title
    titleLbl.TextColor3 = C.text; titleLbl.TextSize = S.txt + 1
    titleLbl.Font = Enum.Font.GothamBold; titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 10; titleLbl.Parent = H

    -- Layout switch button: three bars; the middle one shortens in sidebar mode
    local swBtn = Instance.new("TextButton")
    swBtn.Size = UDim2.new(0,26,0,26); swBtn.Position = UDim2.new(1,-86,0.5,-13)
    swBtn.BackgroundTransparency = 1; swBtn.Text = ""; swBtn.ZIndex = 10; swBtn.Parent = H
    local swBars = {}
    for n = -1, 1 do
        local b = Instance.new("Frame"); b.Size = UDim2.new(0,12,0,2); b.AnchorPoint = Vector2.new(0,0.5)
        b.Position = UDim2.new(0.5,-6,0.5,n*4); b.BackgroundColor3 = C.sub; b.BorderSizePixel = 0
        b.ZIndex = 10; b.Parent = swBtn; corner(b, 1); table.insert(swBars, b)
    end
    local function swLook(hovered)
        local col = hovered and C.text or (W.SidebarMode and C.accent or C.sub)
        for n, b in ipairs(swBars) do
            local w = (W.SidebarMode and n == 2) and 7 or 12
            anim(b, {BackgroundColor3 = col, Size = UDim2.new(0,w,0,2)}, 0.25)
        end
    end
    swBtn.MouseEnter:Connect(function() swLook(true)  end)
    swBtn.MouseLeave:Connect(function() swLook(false) end)

    -- macOS-style window dots (larger on mobile)
    local function windowDot(xOff, hoverCol)
        local ds = S.dotSz
        local d = Instance.new("TextButton")
        d.Size = UDim2.new(0,ds,0,ds); d.AnchorPoint = Vector2.new(0.5,0.5)
        d.Position = UDim2.new(1,xOff+math.floor(ds/2),0.5,0)
        d.BackgroundColor3 = C.none; d.Text = ""; d.BorderSizePixel = 0; d.AutoButtonColor = false
        d.ZIndex = 11; d.Parent = H; corner(d, 99)
        local sc = Instance.new("UIScale"); sc.Parent = d
        d.MouseEnter:Connect(function()  anim(d, {BackgroundColor3 = hoverCol}, 0.16); anim(sc, {Scale = 1.18}, 0.25, BACK) end)
        d.MouseLeave:Connect(function()  anim(d, {BackgroundColor3 = C.none},   0.22); anim(sc, {Scale = 1},    0.22)       end)
        return d
    end

    local clsB = windowDot(-30, C.accent)
    local minB = windowDot(-50, Color3.fromRGB(180,180,180))

    -- Mobile has no toggle key: show a small button to bring the window back
    if isMobile then
        local reopen = Instance.new("TextButton")
        reopen.Size = UDim2.new(0,74,0,28); reopen.AnchorPoint = Vector2.new(0.5,0)
        reopen.Position = UDim2.new(0.5,0,0,8); reopen.BackgroundColor3 = C.card
        reopen.Text = title; reopen.TextColor3 = C.accent; reopen.TextSize = S.txtSm
        reopen.Font = Enum.Font.GothamBold; reopen.TextTruncate = Enum.TextTruncate.AtEnd
        reopen.AutoButtonColor = false; reopen.Visible = false; reopen.ZIndex = 300; reopen.Parent = SG
        corner(reopen, 8); stroke(reopen, C.stroke, 0.2)
        reopen.MouseButton1Click:Connect(function() W:SetVisible(true) end)
        Main:GetPropertyChangedSignal("Visible"):Connect(function() reopen.Visible = not Main.Visible end)
    end

    clsB.MouseButton1Click:Connect(function() W:SetVisible(false) end)
    minB.MouseButton1Click:Connect(function()
        if W.Locked then return end
        W:CloseDropdown()
        W.Minimized = not W.Minimized
        if W.Minimized then
            fullSz = Main.Size
            anim(Main, {Size = UDim2.new(fullSz.X.Scale, fullSz.X.Offset, 0, hH)}, 0.4, QUINT)
        else
            anim(Main, {Size = fullSz}, 0.4, QUINT)
        end
    end)
    swBtn.MouseButton1Click:Connect(function() W:SwitchMode(not W.SidebarMode) end)

    -- Drag — Mouse and Touch. The window eases toward the pointer instead of snapping to it.
    local _d, _di, _ds, _dp, _goal = false, nil, nil, nil, nil
    local function isMoveInput(i)
        return i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch
    end
    table.insert(W.Conns, H.InputBegan:Connect(function(i)
        if isMoveInput(i) then
            W:CloseDropdown()
            _d = true; _di = i; _ds = i.Position; _dp = _goal or Main.Position
        end
    end))
    table.insert(W.Conns, UserInputService.InputEnded:Connect(function(i)
        if isMoveInput(i) then _d = false end
    end))
    table.insert(W.Conns, UserInputService.InputChanged:Connect(function(i)
        if not _d then return end
        -- Follow only the finger that started the drag (not a second touch on the joystick)
        local mine = i == _di or (i.UserInputType == Enum.UserInputType.MouseMovement
            and _di.UserInputType == Enum.UserInputType.MouseButton1)
        if mine then
            local d = i.Position - _ds
            _goal = UDim2.new(_dp.X.Scale, _dp.X.Offset+d.X, _dp.Y.Scale, _dp.Y.Offset+d.Y)
        end
    end))
    table.insert(W.Conns, RunService.RenderStepped:Connect(function(dt)
        if not _goal then return end
        local p = Main.Position:Lerp(_goal, 1 - math.exp(-dt * 22))
        if not _d and math.abs(p.X.Offset - _goal.X.Offset) < 0.5 and math.abs(p.Y.Offset - _goal.Y.Offset) < 0.5 then
            p = _goal; _goal = nil
        end
        Main.Position = p
    end))
    table.insert(W.Conns, UserInputService.InputBegan:Connect(function(i, gp)
        if not gp and i.KeyCode == toggleKey then W:SetVisible(not W.Visible) end
    end))

    -- ── Horizontal tab bar ───────────────────
    local tabYPos = hH + 2
    local TH = Instance.new("Frame"); TH.Name = "TabsH"
    TH.Size = UDim2.new(1,-24,0,S.tabH); TH.Position = UDim2.new(0,12,0,tabYPos)
    TH.BackgroundTransparency = 1; TH.ClipsDescendants = false; TH.Parent = Body

    local THContainer = Instance.new("Frame"); THContainer.Size = UDim2.new(1,0,1,0)
    THContainer.BackgroundTransparency = 1; THContainer.Parent = TH
    local THL = Instance.new("UIListLayout"); THL.FillDirection = Enum.FillDirection.Horizontal
